{
  "name": "dsh-superagent",
  "author": "DeepSeek Harness Team <team@dsh.dev>",
  "license": "MIT",
  "version": "0.2.0-wsl.5",
  "private": true,
  "description": "Experimental Windows Host to WSL execution adaptation of the upstream dsh-superagent research prototype, targeting GitHub tasks on DSH Desktop 0.2.2-rc.5.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./wsl-shell": "./lib/wsl-shell.js",
    "./wsl-fs": "./lib/wsl-fs.js",
    "./wsl-tools": "./lib/wsl-tools.js",
    "./wsl-context": { "types": "./lib/wsl-context.d.ts", "default": "./lib/wsl-context.js" },
    "./workspace-files": { "types": "./lib/workspace-files.d.ts", "default": "./lib/workspace-files.js" },
    "./file-references": { "types": "./lib/file-references.d.ts", "default": "./lib/file-references.js" },
    "./icon": "./icon.svg",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "SETUP.md",
    "docs",
    "WSL-VERIFICATION.md",
    "WSL-ADAPTER.md",
    "scripts/make-local-wsl-bundle.mjs",
    "icon.svg",
    "prompts",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
