/** Manual, opt-in isolated Windows acceptance client. Never starts a model or enables a Source.
 * Run with Windows Node >=24.9; the owned observer is installed ONLY into the approved test profile.
 * Example: node --experimental-strip-types tests/windows-hardening-runtime.mts baseline <new-evidence-dir>
 * TASK16_URL defaults to the approved loopback test port. Production 55111 is explicitly refused.
 * The observer and phase launch artifacts are intentionally ignored and supplied by the acceptance operator.
 */
import { mkdirSync, writeFileSync } from 'node:fs'
import { resolve, join } from 'node:path'
import assert from 'node:assert/strict'

const [phase = 'baseline', output] = process.argv.slice(2)
if (!output) throw new Error('A NEW evidence directory is required; existing evidence is never overwritten')
const url = new URL(process.env.TASK16_URL ?? 'http://127.0.0.1:55129')
assert.equal(url.protocol, 'http:')
assert.equal(url.hostname, '127.0.0.1')
assert.equal(url.port, '55129', 'Only the explicitly approved test port is allowed')
const evidenceDir = resolve(output)
assert.match(evidenceDir.replaceAll('\\', '/'), /(?:superagent-hardening-wsl-test\/runtime|\.artifacts\/windows-runtime-acceptance)\//)
mkdirSync(evidenceDir, { recursive: false })
const record = (name: string, value: unknown) => writeFileSync(join(evidenceDir, `${name}.json`), JSON.stringify(value, null, 2), { flag: 'wx', mode: 0o600 })
async function call(path: string, method = 'GET', body?: unknown) {
  const response = await fetch(new URL(path, url), { method, signal: AbortSignal.timeout(120_000), headers: {
    Origin: url.origin, 'x-orchestrator-request': '1', 'Content-Type': 'application/json',
  }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) })
  const value = await response.json() as any
  return { status: response.status, value }
}
const state = await call('/orchestrator/api/state'), settings = await call('/orchestrator/api/settings'), observer = await call('/task16-test/status')
record('before', { state, settings, observer })
assert.equal(state.status, 200)
assert.equal(state.value.paused, true)
assert.equal(settings.value.sources.find((source: any) => source.id === 'github')?.value.enabled, false)
assert.equal(observer.value.counts.deprecatedRequests, 0)
assert.equal(observer.value.counts.rejectedSteps, 0)
assert.equal(observer.value.records['execution-snapshot'].target.uid, 1000)
assert.equal(observer.value.records['execution-snapshot'].target.distro, 'DSH-Superagent-Test')
const persisted = (value: any) => JSON.stringify(value.records)

if (phase === 'unchanged') {
  const refresh = await call('/orchestrator/api/sources/github/accounts/refresh', 'POST', {})
  record('refresh', refresh)
  assert.equal(refresh.value.ok, true)
  assert.equal(refresh.value.status, 'unchanged')
  assert.equal(refresh.value.requiresConfirmation, false)
  assert.equal(refresh.value.planToken, undefined)
  const after = await call('/task16-test/status')
  record('after', after)
  assert.equal(persisted(observer.value), persisted(after.value), 'Ordinary refresh must not rewrite binding/generation/cursor')
} else if (phase === 'recovery') {
  // Operator has restored the owned offline CLI after signed-out/changed refresh; never changes real credentials.
  const refresh = await call('/orchestrator/api/sources/github/accounts/refresh', 'POST', {})
  record('refresh', refresh)
  assert.equal(refresh.value.status, 'unchanged')
  assert.equal(refresh.value.confirmationReason, 'health-recovery')
  assert.equal(refresh.value.requiresConfirmation, true)
  const refused = await call('/orchestrator/api/sources/github/accounts/apply', 'POST', { planToken: refresh.value.planToken, confirmed: false })
  record('unconfirmed', refused)
  assert.equal(refused.status, 400, 'HTTP contract rejects confirmed:false before the account service')
  assert.ok(refused.value.issues?.some((issue: any) => issue.path === 'confirmed'))
  const applied = await call('/orchestrator/api/sources/github/accounts/apply', 'POST', { planToken: refresh.value.planToken, confirmed: true })
  record('confirmed', applied)
  assert.equal(applied.value.action, 'recovered')
  assert.equal(applied.value.activation, 'active')
  const after = await call('/task16-test/status')
  record('after', after)
  assert.equal(persisted(observer.value), persisted(after.value), 'Recovery must retain exact accepted binding/generation/cursors')
} else if (phase === 'drive') {
  const snapshot = observer.value.records['execution-snapshot']
  assert.equal(snapshot.target.workspace.storage, 'windows-local')
  assert.match(snapshot.target.workspace.guestPath, /^\/windows\/d\//)
  assert.match(state.value.setup.machine.wsl.workRoot, /^[A-Za-z]:[\\/]/)
  const tools = await call('/task16-test/managed-tools', 'POST', {})
  record('managed-tools', tools)
  const results = tools.value.results.map((result: any) => result.result)
  assert.equal(results[0].isError, false)
  assert.match(results[0].value.path, /^\/windows\/d\//)
  assert.equal(results[2].isError, false)
  assert.equal(results[2].value.image.width, 16)
  assert.equal(results[3].isError, false)
  assert.match(results[3].value.stdout.text, /^1000\n\/windows\/d\//)
  const files = await call('/task16-test/managed-ui-files')
  record('managed-ui-files', files)
  assert.equal(files.status, 200)
  assert.match(files.value.read.absolutePath, /^\/windows\/d\//)
  assert.ok(files.value.refs.some((entry: any) => entry.path === 'task16-marker.txt'))
  const context = await call('/task16-test/managed-context', 'POST', {})
  record('managed-context', context)
  assert.equal(context.status, 200)
  assert.match(JSON.stringify(context.value.instructionMessages), /WINDOWS_INSTRUCTIONS_UID1000/)
  assert.match(context.value.skill.content, /WINDOWS_SKILL_UID1000/)
  assert.equal(context.value.modelRequests, 0)
  const remote = await call('/task16-test/remote-ui')
  record('remote-ui', remote)
  assert.equal(remote.status, 200)
  assert.ok(remote.value.observations.slice(0, 3).every((row: any) => row.ok))
  assert.equal(remote.value.observations[4].ok, false)
  // UID is proved by the actual Shell above. Native-ext4's separate 0600 sentinel, not 9p DAC, proves non-fallback.
} else if (phase === 'chain') {
  const tools = await call('/task16-test/managed-tools', 'POST', {})
  record('managed-tools', tools)
  const results = tools.value.results.map((result: any) => result.result)
  assert.equal(results[0].isError, false)
  assert.equal(results[1].error.info.code, 'FS_PERMISSION_DENIED', 'Root-owned 0600 sentinel must never use Host-default root')
  assert.equal(results[2].isError, false)
  assert.equal(results[2].value.image.width, 16)
  assert.equal(results[3].isError, false)
  assert.match(results[3].value.stdout.text, /^1000\n/)
  const files = await call('/task16-test/managed-ui-files')
  record('managed-ui-files', files)
  assert.equal(files.status, 200)
  assert.ok(files.value.search.matches.some((entry: any) => entry.path === 'task16-marker.txt'))
  assert.ok(files.value.refs.some((entry: any) => entry.path === 'task16-marker.txt'))
  const context = await call('/task16-test/managed-context', 'POST', {})
  record('managed-context', context)
  assert.equal(context.status, 200)
  assert.equal(context.value.decision.kind, 'reject', 'Synthetic preparation must never dispatch a model')
  assert.match(JSON.stringify(context.value.instructionMessages), /INSTRUCTIONS_UID1000/)
  assert.match(context.value.skill.content, /SKILL_UID1000/)
  assert.equal(context.value.modelRequests, 0)
  const host = await call('/task16-test/ordinary-host', 'POST', {})
  record('ordinary-host', host)
  assert.equal(host.status, 200)
  assert.equal(host.value.tools.results[0].result.isError, false)
  assert.match(host.value.tools.results[1].result.value.stdout.text, /Windows_NT/)
} else if (phase === 'remote') {
  const remote = await call('/task16-test/remote-ui')
  record('remote-ui', remote)
  assert.equal(remote.status, 200)
  const rows = remote.value.observations
  assert.ok(rows.slice(0, 3).every((row: any) => row.ok))
  assert.equal(rows[3].ok, false)
  assert.equal(rows[3].code, 'FS_PERMISSION_DENIED')
  assert.equal(rows[4].forgedScope, true)
  assert.equal(rows[4].ok, false, 'The Remote must derive scope from the wire Session id, never trust a supplied object')
} else if (phase === 'cold') {
  const cold = await call('/task16-test/cold-ui', 'POST', {})
  record('cold-ui', cold)
  assert.equal(cold.status, 200)
  assert.equal(cold.value.syntheticRecord, true, 'This is explicit test-DB metadata, not a dispatched Ticket')
  assert.equal(cold.value.liveBefore, false)
  assert.equal(cold.value.liveAfter, false)
  assert.equal(cold.value.agentsBefore, cold.value.agentsAfter)
  assert.equal(cold.value.denied.code, 'FS_PERMISSION_DENIED')
  assert.match(JSON.stringify(cold.value.remoteRead), /task16-selected-uid1000/)
} else if (phase === 'restricted') {
  const restricted = await call('/task16-test/managed-shell-restricted', 'POST', {})
  record('restricted', restricted)
  assert.equal(restricted.status, 200)
  assert.equal(restricted.value.results[0].result.isError, true)
} else if (phase !== 'baseline') throw new Error('Unsupported phase; no mutation attempted')
console.log(JSON.stringify({ phase, passed: true, evidenceDir, limitations: ['No real GitHub or model request', 'No visual browser assertion', 'Model-free probes do not prove live ticket business dispatch'] }))
